{
  "initializationAction": "(q.npc.is_in_battle_with(q.player) || !q.npc.is_doing_activity('minecraft:idle', 'cobblemon:battling')) ? q.dialogue.close()",
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face(false);"
    },
    "player": {
      "face": "q.player.face();",
      "name": {
        "type": "expression",
        "expression": "q.player.username"
      }
    }
  },
  "pages": [
    {
      "id": "player-chat",
      "speaker": "player",
      "lines": [
        "dialogue.bca.s1.npcs.s1.dragoon217.player-chat.line.1"
      ],
      "input": "q.dialogue.set_page(q.npc.was_hurt_by(q.player) ? 'hurt-1' : 'npc-chat');"
    },
    {
      "id": "hurt-1",
      "speaker": "npc",
      "lines": [
        "dialogue.bca.s1.npcs.s1.dragoon217.hurt-1.line.1"
      ],
      "input": "q.dialogue.close();"
    },
    {
      "id": "npc-chat",
      "speaker": "npc",
      "lines": [
        "dialogue.bca.s1.npcs.s1.dragoon217.npc-chat.line.1"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "dialogue.bca.s1.npcs.s1.dragoon217.npc-chat.option.battle.1",
            "value": "battle",
            "action": [
              "q.dialogue.set_page('battle')"
            ]
          },
          {
            "text": "dialogue.bca.s1.npcs.s1.dragoon217.npc-chat.option.about.me.2",
            "value": "about_me",
            "action": [
              "q.dialogue.set_page('about_me')"
            ]
          },
          {
            "text": "dialogue.bca.s1.npcs.s1.dragoon217.npc-chat.option.cancel.3",
            "value": "cancel",
            "action": [
              "q.dialogue.close()"
            ]
          }
        ]
      }
    },
    {
      "id": "about_me",
      "speaker": "npc",
      "lines": [
        "dialogue.bca.s1.npcs.s1.dragoon217.about.me.line.1"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "dialogue.bca.s1.npcs.s1.dragoon217.about.me.option.back.1",
            "value": "back",
            "action": [
              "q.dialogue.set_page('npc-chat')"
            ]
          },
          {
            "text": "dialogue.bca.s1.npcs.s1.dragoon217.about.me.option.cancel.2",
            "value": "cancel",
            "action": [
              "q.dialogue.close()"
            ]
          }
        ]
      }
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "dialogue.bca.s1.npcs.s1.dragoon217.battle.line.1"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "dialogue.bca.s1.npcs.s1.dragoon217.battle.option.battle.1",
            "value": "battle",
            "action": [
              "q.dialogue.close();",
              "q.npc.start_battle(q.player);"
            ],
            "isSelectable": "c.npc.can_battle;"
          }
        ]
      }
    }
  ]
}
