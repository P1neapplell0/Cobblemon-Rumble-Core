            "value": "facility_info",
            "action": [
              "q.dialogue.set_page('facility_info')"
            ]
          },
          {
            "text": "dialogue.bca.receptionists.wyrmsrest.npc-chat2.option.cancel.3",
            "value": "cancel",
            "action": [
