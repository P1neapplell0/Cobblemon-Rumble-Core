{
  "initializationAction": "(q.npc.is_in_battle_with(q.player) || !q.npc.is_doing_activity('minecraft:idle', 'cobblemon:battling')) ? q.dialogue.close()",
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face(false);"
    },
    "player": {
      "face": "q.player.face();",
      "name": {
        "type": "expression",
        "expression": "q.player.username"
      }
    }
  },
  "pages": [
    {
      "id": "player-chat",
      "speaker": "player",
      "lines": [
        "dialogue.bca.receptionists.wyrmsrest.player-chat.line.1"
      ],
      "input": "q.dialogue.set_page(q.npc.was_hurt_by(q.player) ? 'hurt-1' : 'npc-chat');"
    },
    {
      "id": "hurt-1",
      "speaker": "npc",
      "lines": [
        "dialogue.bca.receptionists.wyrmsrest.hurt-1.line.1"
      ],
      "input": "q.dialogue.close();"
    },
    {
      "id": "npc-chat",
      "speaker": "npc",
      "lines": [
        "dialogue.bca.receptionists.wyrmsrest.npc-chat.line.1"
      ],
